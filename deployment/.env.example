# 三鼎统一部署配置：复制为 .env 后按需修改（cp .env.example .env）。
# .env 已被 git 忽略；路径一律写绝对路径。
# 只有三个服务：echuan（驿传）、dsh-agent（合并 Host）、browserless（无头浏览器）。

# ══════════════════════════════════════════════════════════════════════════
# 一、源码位置
# ══════════════════════════════════════════════════════════════════════════
# 驿传平台仓库（含 Dockerfile / configs）
ECHUAN_SRC=/Users/reachlucifer/project/opc/echuan_v2
# 合并 Host 的镜像源码（本仓库内；插件启动时从 npm 安装，不需要宿主插件源码）
DSH_DEV_SRC=/Users/reachlucifer/project/opc/sanding/agents/dsh-agent-dev

# ══════════════════════════════════════════════════════════════════════════
# 二、运行期路径与端口
# ══════════════════════════════════════════════════════════════════════════
# agent 共享的工作区（宿主项目目录，挂 /workspace）
HOST_PROJECT_PATH=/Users/reachlucifer/project/dsh-workspaces

# 驿传数据目录（SQLite / objects / workspaces），相对本 compose 文件或绝对路径
ECHUAN_DATA_DIR=./echuan/data

# 合并 Host 的 dsh home（profile / 会话 / relay 证书与配对设备）
DSH_MERGED_HOME_DIR=./data/dsh-home-agent

# 端口：echuan 只绑 127.0.0.1；dsh-relay 是对外唯一入口
ECHUAN_PORT=8721
DSH_RELAY_PORT=3443
# 0.0.0.0 = 允许手机 / 组网设备连；只想本机用时改成 127.0.0.1
DSH_RELAY_BIND=0.0.0.0

# ══════════════════════════════════════════════════════════════════════════
# 三、浏览器服务（browserless / 无头 Chromium）
# ══════════════════════════════════════════════════════════════════════════
BROWSERLESS_IMAGE=ghcr.io/browserless/chromium:latest
# 宿主回环端口（容器内固定 3000）
BROWSERLESS_PORT=3000

# 必填：访问令牌。生成方式：openssl rand -hex 32
# agent 容器内连接：ws://host.docker.internal:3001?token=<TOKEN>
# 宿主本机连接：    ws://127.0.0.1:3001?token=<TOKEN>
BROWSERLESS_TOKEN=

BROWSERLESS_CONCURRENT=3
BROWSERLESS_QUEUED=5
BROWSERLESS_TIMEOUT=60000
# Chrome 共享内存，官方要求至少 2g（默认 64m 会崩）
BROWSERLESS_SHM_SIZE=2g
BROWSERLESS_DATA_DIR=./data/browserless

# ══════════════════════════════════════════════════════════════════════════
# 四、镜像与版本
# ══════════════════════════════════════════════════════════════════════════
ECHUAN_IMAGE=echuan:local
DSH_MERGED_IMAGE=dsh-agent-dev:local

# 镜像内 dsh 与插件 peer 版本必须一致
DSH_VERSION=0.2.1-rc.2
GH_VERSION=2.95.0

# dsh profile 名称（插件装进该 profile）
DSH_PROFILE=web

# 插件安装源；指向本地 verdaccio 时写 http://host.docker.internal:4873
NPM_REGISTRY=https://registry.npmmirror.com

# ══════════════════════════════════════════════════════════════════════════
# 五、宿主能力与代理
# ══════════════════════════════════════════════════════════════════════════
# Docker socket：Docker Desktop → /var/run/docker.sock；Colima → ${HOME}/.colima/default/docker.sock
DOCKER_SOCKET=/var/run/docker.sock
# devcontainer CLI / 插件访问外网的代理（留空 = 直连；填 host.docker.internal:7890）
DOCKER_PROXY=
# GitHub PAT（classic，scope: repo / read:org）。留空 = 容器内 gh 未登录。
GH_TOKEN=

# ══════════════════════════════════════════════════════════════════════════
# 六、合并 Host 的插件清单
# ══════════════════════════════════════════════════════════════════════════
# 空格分隔的 <name>@<exact-version>，顺序即安装顺序。
# 三个角色包同 profile，技能按 preset 隔离；一个 profile 只装这一份清单。
DSH_MERGED_PLUGIN_SPECS="dsh-agent-cto@0.7.1 dsh-agent-pm@0.7.1 dsh-agent-dev@0.8.2 dsh-echuan@0.5.4 dsh-agent-base@0.2.0 dsh-browser-native@0.1.0 dsh-local-admission@0.1.1 dsh-relay@0.4.0"

# ══════════════════════════════════════════════════════════════════════════
# 七、LLM 与 relay
# ══════════════════════════════════════════════════════════════════════════
# LLM API Key（环境层优先于 .credentials.yaml，Web 设置页无法覆盖）
DEEPSEEK_API_KEY=

# relay 插件版本（运行期安装；升级只改此值 + docker compose up -d，无需重建镜像）
# 建议用精确版本；写 latest 会在每次启动时重新解析安装
DSH_RELAY_PLUGIN=dsh-relay@0.4.0

# relay 登录密码（≥10 字符）。relay 不读配置文件，用 ./scripts/relay-password.sh 应用
DSH_RELAY_PASSWORD=

# ══════════════════════════════════════════════════════════════════════════
# 八、可选覆盖（一般无需修改）
# ══════════════════════════════════════════════════════════════════════════
TZ=Asia/Shanghai
# COMPOSE_PROJECT_NAME=sanding
# ECHUAN_CONTAINER_NAME=echuan
# DSH_MERGED_CONTAINER_NAME=dsh-agent
# BROWSERLESS_CONTAINER_NAME=browserless
# ECHUAN_UID=10001
# ECHUAN_GID=10001
# ECHUAN_LOG_LEVEL=
# ECHUAN_CONFIG_FILE=./echuan/echuan.container.toml
# ECHUAN_VERSION=dev
# ECHUAN_COMMIT=none

# 构建期代理（默认清空 = 直连）
# DOCKER_BUILD_HTTP_PROXY=
# DOCKER_BUILD_HTTPS_PROXY=
# DOCKER_BUILD_ALL_PROXY=
# DOCKER_BUILD_GOPROXY=https://goproxy.cn,https://proxy.golang.org,direct
# DOCKER_BUILD_NPM_REGISTRY=https://registry.npmmirror.com
# DOCKER_BUILD_APK_MIRROR=mirrors.aliyun.com
# DOCKER_BUILD_IMAGE_MIRROR=
# DOCKER_BUILD_NODE_IMAGE=node:22-alpine
# DOCKER_BUILD_GO_IMAGE=golang:1.26-alpine
# DOCKER_BUILD_RUNTIME_IMAGE=alpine:3.20

# ── 一体化主智能体测试 service（复用主线平台，独立 relay）─────────────────────────────────
DSH_ONE_CONTAINER_NAME=dsh-agent-one
DSH_ONE_RELAY_PORT=3444
DSH_ONE_HOME_DIR=./data/dsh-home-one
DSH_ONE_PLUGIN_SPECS="dsh-agent-one@0.2.2 dsh-echuan@0.5.4 dsh-agent-base@0.2.0 dsh-browser-native@0.1.0 dsh-local-admission@0.1.1 dsh-relay@0.4.0"
