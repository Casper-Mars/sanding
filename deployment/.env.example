# 三鼎统一部署配置：复制为 .env 后按需修改（cp .env.example .env）。
# .env 已被 git 忽略；路径一律写绝对路径。

# ══════════════════════════════════════════════════════════════════════════
# 一、源码位置（本仓库不含源码，compose 直接指向同级仓库）
# ══════════════════════════════════════════════════════════════════════════
# 驿传平台仓库（含 Dockerfile / configs）
ECHUAN_SRC=/Users/reachlucifer/project/opc/echuan_v2
# CTO Agent（本仓库内）
# 产品经理 Agent（本仓库内）

# 开发 Agent（本仓库内，插件从 npm 安装，不需要宿主插件源码）
DSH_AGENT_SRC=/Users/reachlucifer/project/opc/sanding/agents/dsh-agent-base
DSH_DEV_SRC=/Users/reachlucifer/project/opc/sanding/agents/dsh-agent-dev


# ══════════════════════════════════════════════════════════════════════════
# 二、运行期路径与端口
# ══════════════════════════════════════════════════════════════════════════
# agent 共享的工作区（宿主项目目录）
HOST_PROJECT_PATH=/Users/reachlucifer/project/opc/devcontainer/test

# 驿传数据目录（SQLite / objects / workspaces）
ECHUAN_DATA_DIR=/Users/reachlucifer/echuan-v2-data

# dsh home（profile / 会话 / cordis.patch.yml）。rel 路径相对本 compose 文件。
DSH_CTO_HOME_DIR=./data/dsh-home-cto
DSH_PM_HOME_DIR=./data/dsh-home-pm
DSH_DEV_HOME_DIR=./data/dsh-home-dev

# 端口（只绑 127.0.0.1）
ECHUAN_PORT=8721
DSH_CTO_PORT=8090
DSH_PM_PORT=8093
DSH_DEV_PORT=8091
# 合并 Host（单 Host 多角色）：与旧三台错开端口，便于并存回退
DSH_MERGED_PORT=8095
DSH_MERGED_HOME_DIR=./data/dsh-home-agent
DSH_MERGED_PLUGIN_SPECS=dsh-agent-cto@0.5.3 dsh-agent-pm@0.5.1 dsh-agent-dev@0.7.1 dsh-echuan@0.2.2 dsh-agent-base@0.2.0 dsh-browser-native@0.1.0 dsh-local-admission@0.1.1
# 统一入口（Caddy 子域反代 + 门户页）
DSH_PORTAL_PORT=8080

# ══════════════════════════════════════════════════════════════════════════
# 三、浏览器服务（browserless / 无头 Chromium）
# ══════════════════════════════════════════════════════════════════════════
BROWSERLESS_IMAGE=ghcr.io/browserless/chromium:latest
# 宿主回环端口（容器内固定 3000）
BROWSERLESS_PORT=3000

# 必填：访问令牌。生成方式：openssl rand -hex 32
# 不要使用 test-token / 空值；healthcheck 与客户端连接都用它。
# agent 容器内连接：ws://host.docker.internal:3001?token=<TOKEN>
# 宿主本机连接：    ws://127.0.0.1:3001?token=<TOKEN>
BROWSERLESS_TOKEN=

# 会话上限与超时（毫秒）
BROWSERLESS_CONCURRENT=3
BROWSERLESS_QUEUED=5
BROWSERLESS_TIMEOUT=60000
# Chrome 共享内存，官方要求至少 2g（默认 64m 会崩）
BROWSERLESS_SHM_SIZE=2g
# 用户数据 / 下载落盘目录（相对本 compose 文件或绝对路径）
BROWSERLESS_DATA_DIR=./data/browserless

# ══════════════════════════════════════════════════════════════════════════
# 四、镜像与版本
# ══════════════════════════════════════════════════════════════════════════
ECHUAN_IMAGE=echuan-v2:local
DSH_AGENT_IMAGE=dsh-agent-base:local
DSH_DEV_IMAGE=dsh-agent-dev:local

# 镜像内 dsh 与插件 peer 版本必须一致（npm latest 是 0.0.1-rc.1，会被守卫拒绝）
DSH_VERSION=0.2.1-rc.2
# gh CLI 版本（与宿主对齐）
GH_VERSION=2.95.0

# dsh profile 名称（插件装进该 profile）
DSH_PROFILE=web

# 构建期依赖源（国内加速）
NPM_REGISTRY=https://registry.npmmirror.com

# ══════════════════════════════════════════════════════════════════════════
# 五、宿主能力与代理
# ══════════════════════════════════════════════════════════════════════════
# Docker socket：Docker Desktop → /var/run/docker.sock；Colima → ${HOME}/.colima/default/docker.sock
DOCKER_SOCKET=/var/run/docker.sock

# devcontainer CLI 访问 ghcr.io 的代理（留空 = 直连）
DOCKER_PROXY=

# 两个 agent 的插件清单：空格分隔的 <name>@<exact-version>，顺序即安装顺序
# 注意：一个 profile 只能装一个角色包（cto / dev 二者互斥）
DSH_CTO_PLUGIN_SPECS=dsh-agent-cto@0.1.0 dsh-echuan@0.1.0 dsh-agent-base@0.1.0 dsh-browser-native@0.1.0 dsh-local-admission@0.1.1
DSH_PM_PLUGIN_SPECS=dsh-agent-pm@0.1.0 dsh-echuan@0.1.0 dsh-agent-base@0.1.0 dsh-browser-native@0.1.0 dsh-local-admission@0.1.1
DSH_DEV_PLUGIN_SPECS=dsh-agent-dev@0.2.0 dsh-echuan@0.1.0 dsh-agent-base@0.1.0 dsh-browser-native@0.1.0 dsh-local-admission@0.1.1

# dev-agent 用的 GitHub PAT（classic，scope: repo / read:org）。留空 = 容器内 gh 未登录。
GH_TOKEN=

# ══════════════════════════════════════════════════════════════════════════
# 六、可选覆盖（一般无需修改）
# ══════════════════════════════════════════════════════════════════════════
TZ=Asia/Shanghai
# COMPOSE_PROJECT_NAME=sanding
# ECHUAN_CONTAINER_NAME=echuan-v2
# DSH_CTO_CONTAINER_NAME=dsh-agent-cto
# DSH_PM_CONTAINER_NAME=dsh-agent-pm
# DSH_DEV_CONTAINER_NAME=dsh-agent-dev
# BROWSERLESS_CONTAINER_NAME=browserless
# ECHUAN_UID=10001
# ECHUAN_GID=10001
# ECHUAN_LOG_LEVEL=
# ECHUAN_CONFIG_FILE=./echuan/echuan.container.toml   # 默认值，一般无需设置
# ECHUAN_VERSION=dev
# ECHUAN_COMMIT=none

# 构建期代理（默认清空 = 直连；需要时填 host.docker.internal:7890）
# DOCKER_BUILD_HTTP_PROXY=
# DOCKER_BUILD_HTTPS_PROXY=
# DOCKER_BUILD_ALL_PROXY=
# DOCKER_BUILD_GOPROXY=https://goproxy.cn,https://proxy.golang.org,direct
# DOCKER_BUILD_NPM_REGISTRY=https://registry.npmmirror.com
# DOCKER_BUILD_APK_MIRROR=mirrors.aliyun.com
# DOCKER_BUILD_IMAGE_MIRROR=
# DOCKER_BUILD_NODE_IMAGE=node:22-alpine
# DOCKER_BUILD_GO_IMAGE=golang:1.26-alpine
# DOCKER_BUILD_RUNTIME_IMAGE=alpine:3.20

# LLM API Key（三个 agent 共用；环境层优先于 .credentials.yaml，Web 设置页无法覆盖）
DEEPSEEK_API_KEY=

# relay 插件版本（运行期安装；升级只改此值 + docker compose up -d，无需重建镜像）
# 建议用精确版本；写 latest 会在每次启动时重新解析安装
DSH_RELAY_PLUGIN=dsh-relay@0.4.0

# relay 登录密码（≥10 字符）。relay 不读配置文件，用 ./scripts/relay-password.sh 应用
DSH_RELAY_PASSWORD=
