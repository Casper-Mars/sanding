# 复制为 .env 后按需修改：cp .env.example .env
# .env 中的路径请写绝对路径。

# ── 必填 ──────────────────────────────────────────────────────────────────
# 宿主上项目目录的【绝对】路径（macOS 路径）。
# 它同时挂进 agent 容器（/workspace）与同路径挂载（供 devcontainer CLI 用）。
HOST_PROJECT_PATH=

# dsh home 的宿主目录（bind mount）：profile / 会话 / cordis.patch.yml 都在这里。
# 插件安装结果为 <DSH_HOME_DIR>/profiles/<profile>/node_modules，不落在镜像里。
DSH_HOME_DIR=./dsh-home

# ── 可选 ──────────────────────────────────────────────────────────────────
# 插件清单：空格分隔的 <name>@<exact-version>，顺序即安装顺序
# （dsh-agent-dev 必须在 dsh-echuan 之前：它的 patch 先插入 dev 领域与 preset）。
# 启动时逐条 `dsh plugin add`（幂等）；升级/回滚都只改这一行。
PLUGIN_SPECS=dsh-agent-dev@0.2.0 dsh-echuan@0.1.0 dsh-agent-base@0.1.0 dsh-browser-native@0.1.0

# 安装插件用的 registry（npmmirror 可能滞后于官方源；新发布的版本可临时改官方源）
NPM_REGISTRY=https://registry.npmmirror.com

# Docker socket 路径：
#   Docker Desktop for Mac → /var/run/docker.sock（默认，留空即可）
#   Colima                → ${HOME}/.colima/default/docker.sock
DOCKER_SOCKET=/var/run/docker.sock

# devcontainer CLI 访问 ghcr.io 用的代理（留空 = 直连）
DOCKER_PROXY=

# dsh profile 名称（插件装进该 profile）
DSH_PROFILE=web

# 镜像内 dsh 版本（构建参数）；插件 peer 钉在同一版本，改它需同步插件
DSH_VERSION=0.2.1-rc.2

# 宿主机映射端口（只绑 127.0.0.1；3080 已被现有 dsh-agent 占用）
DSH_PORT=3081

# GitHub PAT（classic，scope: repo / read:org，按需加 workflow）。
# .env 已在 .gitignore 里，不会进 git；留空 = 容器内 gh 未登录，不阻断启动。
GH_TOKEN=

# 镜像内 gh 版本（官方 release，构建时下载并校验 checksums），与宿主对齐
GH_VERSION=2.95.0
